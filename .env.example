# Database Configuration (MySQL / Aiven / Local)
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=bms_unified
DB_USER=your-mysql-user
DB_PASS=your-mysql-password

# Optional SSL configuration for Aiven (download ca.pem from Aiven Console)
DB_SSL_CA=ca.pem
DB_SSL_VERIFY=true

# Gmail settings used by shared/notifications.php.
BMS_GMAIL_FROM=your-gmail-address
BMS_GMAIL_APP_PASSWORD=your-gmail-app-password
BMS_GMAIL_FROM_NAME=Ellen Boarding House
BMS_ADMIN_EMAIL=your-admin-email

# SMTP fallback for deployments that use PHPMailer.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-gmail-address
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-gmail-address
SMTP_FROM_NAME=Ellen Boarding House
SMTP_ENCRYPTION=ssl